@model Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Categories" asp-action="Index">Categories</a></li>
            <li class="breadcrumb-item">
                <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category.Name</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row mt-4">
        <div class="col-md-6 mb-4">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" class="img-fluid rounded shadow" alt="@Model.Name" style="width: 100%; max-height: 500px; object-fit: cover;">
            }
            else
            {
                <div class="bg-secondary d-flex align-items-center justify-content-center rounded" style="height: 500px;">
                    <span class="text-white">No Image Available</span>
                </div>
            }
        </div>
        <div class="col-md-6">
            <h1 class="display-5 fw-bold">@Model.Name</h1>
            <h2 class="text-success mb-4">$@Model.Price.ToString("F2")</h2>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Description</h5>
                    <p class="card-text lead">@Model.Description</p>
                    <hr />
                    <p class="mb-0"><strong>Category:</strong> <span class="badge bg-primary">@Model.Category.Name</span></p>
                </div>
            </div>

            <div class="mt-4">
                <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-secondary btn-lg">← Back to Products</a>
            </div>
        </div>
    </div>
</div>